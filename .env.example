# Copy to .env and adjust. .env is gitignored — never commit real secrets.

# Shared HS256 secret used by all three services to validate JWTs.
# Must be at least 32 bytes.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes

# MySQL
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=stormapi
MYSQL_USER=stormapi
MYSQL_PASSWORD=stormapi
